+            for key,file,digest in [('input','input.npz','input_sha256'),('truth','truth.npz','truth_sha256'),('rgbd_input','rgbd_input.npz','rgbd_sha256')]:
+                row[key]=str((folder/file).relative_to(ROOT));row[digest]=sha(folder/file)
