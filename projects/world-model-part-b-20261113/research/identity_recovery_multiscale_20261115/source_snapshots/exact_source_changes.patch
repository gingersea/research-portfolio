+        'recovery_sha256':sha(ROOT/'recovery.py'),'source_sha256':sha(Path(__file__)),'overlap_with_prior118':0},indent=2)+'\n')
+    print(json.dumps({'cases':48,'heldout':36,'prior_controls_retired':118,'overlap':0}))
