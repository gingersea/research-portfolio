+    shutil.copy2('/data/AI_Research/shared/research_plans/world_model_measurement_validation_20261115.md', handoff / 'SHARED_PLAN.md')
+    (handoff / 'README.md').write_text(
+        '# Existing-label measurement validation\n\n'
